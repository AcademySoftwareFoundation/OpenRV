+size_t ComputeSignalStackSize(size_t page_size) {
+  // On glibc < 2.34, SIGSTKSZ is a fixed 8 KiB constant that neither accounts
+  // for AT_MINSIGSTKSZ (e.g. AVX-512 XSAVE state in rt_sigframe) nor for
+  // ClientToServerMessage's PATH_MAX union and unoptimized Debug stack frames.
+  constexpr size_t kMinHandlerStackSize = 64 * 1024;
+  const long sys_sigstksz = SIGSTKSZ;
+  const size_t sigstksz =
+      sys_sigstksz > 0 ? static_cast<size_t>(sys_sigstksz) : 0;
+  const int saved_errno = errno;
+#ifndef AT_MINSIGSTKSZ
+#define AT_MINSIGSTKSZ 51
+#endif
+  const size_t min_sigstksz = static_cast<size_t>(getauxval(AT_MINSIGSTKSZ));
+  errno = saved_errno;
+  const size_t base_size =
+      std::max(sigstksz, kMinHandlerStackSize) + min_sigstksz;
+#if defined(ADDRESS_SANITIZER)
+  const size_t stack_size = 2 * base_size;
+#else
+  const size_t stack_size = base_size;
+#endif  // ADDRESS_SANITIZER
+  return (stack_size + page_size - 1) & ~(page_size - 1);
+}
